# FreshTrack Backend Environment Variables
PORT=5000
TABLE_NAME=FreshTrackItems
AWS_REGION=ap-south-1
USE_AWS_DYNAMO=false

# Optional: AWS Credentials (if deploying or running against live AWS outside Lambda execution role)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# Optional: Local DynamoDB endpoint (if using dynamodb-local docker container)
# DYNAMODB_ENDPOINT=http://localhost:8000
